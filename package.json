{
  "name": "altium-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Altium Designer (Windows)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "altium-mcp": "dist/index.js",
    "altium-mcp-install-skill": "scripts/install-cursor-skill.mjs"
  },
  "files": [
    "dist",
    "altium-scripts",
    "skills",
    "scripts/install-cursor-skill.mjs"
  ],
  "scripts": {
    "build": "tsc && node scripts/sync-cursor-skill.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "altium",
    "pcb",
    "model-context-protocol"
  ]
}
